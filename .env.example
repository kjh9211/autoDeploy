# Copy to .env and fill in real values before running the app.

# Shared MySQL 8.0 instance, dedicated `ops_console` schema
# (docs/PLANNING.md §8 — "기존 공유 MySQL에 ops_console 스키마를 하나 추가").
DATABASE_URL="mysql://ops_console:CHANGE_ME@localhost:3306/ops_console"

# Signs session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET="CHANGE_ME_32_BYTES_MINIMUM"

# Same certs/ folder webproxy loads addContext() SNI contexts from.
CERTS_DIR="E:\\webproxy\\certs"

# PM2's dump.pm2, used to detect an unsaved process-list change.
DUMP_PM2_PATH="C:\\Users\\<user>\\.pm2\\dump.pm2"
