// Ops Console data model — tables are added as the phase that needs them
// (docs/PLANNING.md §9) is built, not all up front. Phase 0 added User/App;
// Phase 1 added AuditLog for control actions; Phase 2 added DeployLog and the
// App fields the deploy pipeline needs. Phase 3 (webproxy routes, Cloudflare
// DNS) adds no tables at all — both are read live from their adapters, same
// as PM2/NSSM status and cert expiry, and only route/DNS *changes* land in
// AuditLog. docs/PLANNING.md §5's dns_cache is deliberately skipped for the
// same reason PM2/NSSM state was never cached.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum AppType {
  node_app
  static_web
  discord_bot
  minecraft
}

enum AppRuntime {
  pm2
  nssm
}

enum UserRole {
  admin
  viewer
}

/// Single/small set of operator accounts. Phase 0 only ever creates and logs
/// in as `admin` — `role` exists so Phase 5's viewer-role UI doesn't need a
/// schema migration later (see docs/PLANNING.md §7).
model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  totpSecret   String
  role         UserRole @default(admin)
  createdAt    DateTime @default(now())

  @@map("users")
}

/// App registry — the metadata Ops Console needs to know an app exists and
/// how to reach it. Populated manually via /apps/new in Phase 0; the
/// onboarding wizard in docs/PLANNING.md §3.3 that also provisions PM2,
/// webproxy routing, and DNS is Phase 3/4.
model App {
  id          Int        @id @default(autoincrement())
  name        String     @unique
  type        AppType
  runtime     AppRuntime

  // Identifies the process to query for live status.
  pm2Name     String?
  nssmService String?

  // Local git clone, used for the on-demand "업데이트 확인" diff (§6.4).
  // Null for apps that aren't a git checkout (e.g. downloaded server jars).
  localPath   String?
  branch      String?

  domain      String?
  notes       String?    @db.Text

  // Only used for an NSSM app's real-time log tail (Phase 1, §9) — the file
  // NSSM's AppStdout/AppStderr redirect to. PM2 apps stream via pm2's log
  // bus instead and don't need this.
  logPath     String?

  // Deploy pipeline (Phase 2, §6.4) — all optional because a step only runs
  // when the corresponding command/path is configured. Values are entered
  // once by the admin registering the app (same trust level as them typing
  // these same commands by hand today), not attacker-reachable input.
  buildCmd          String?
  migrateCmd        String?
  deployCommandsCmd String?
  // Path prefix (relative to localPath) whose changes trigger deployCommandsCmd,
  // e.g. "src/commands" — mirrors the package.json/schema.sql diff checks.
  commandsPath      String?
  // Optional HTTP health check hit right after restart, before `pm2 save`.
  // Apps without an HTTP surface (Discord bots) just skip this step.
  healthcheckUrl    String?

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("apps")
}

enum AuditAction {
  app_start
  app_stop
  app_restart
  app_deploy
  app_rollback
  proxy_route_change
  proxy_certs_reload
  dns_record_change
}

/// Every control action (docs/PLANNING.md §7 — "위험한 작업에 대한 감사 로그").
/// Read-only actions (status checks, git fetch) are not logged here.
model AuditLog {
  id         Int         @id @default(autoincrement())
  actorEmail String
  action     AuditAction
  appId      Int?
  appName    String
  success    Boolean
  detail     String?     @db.Text
  createdAt  DateTime    @default(now())

  @@map("audit_log")
}

enum DeployTriggerMode {
  update
  rollback
}

enum DeployStatus {
  running
  success
  failed
}

/// One row per pipeline run (docs/PLANNING.md §6.4/§9). `stepsJson` is the
/// full step-by-step record (name/status/output) — updated as each step
/// finishes so a page refresh always reflects current progress even without
/// the live SSE stream (src/lib/deploy/events.ts) connected.
model DeployLog {
  id          Int               @id @default(autoincrement())
  appId       Int
  appName     String
  triggeredBy String
  mode        DeployTriggerMode
  fromCommit  String?
  toCommit    String?
  status      DeployStatus      @default(running)
  stepsJson   String            @db.Text
  startedAt   DateTime          @default(now())
  finishedAt  DateTime?

  @@map("deploy_logs")
}
